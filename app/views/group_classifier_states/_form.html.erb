<%= form_with(model: group_classifier_state, class: "space-y-6", id: "group-classifier-state-form") do |form| %>
  <% if group_classifier_state.errors.any? %>
    <div id="error_explanation" class="bg-red-50 text-red-500 px-3 py-2 font-medium rounded-md mt-3">
      <h2><%= pluralize(group_classifier_state.errors.count, t('.error_label', default: 'error')) %> <%= t('.error_header') %></h2>

      <ul class="list-disc ml-6">
        <% group_classifier_state.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="bg-white p-6 rounded-lg shadow-md border border-gray-200 space-y-5">
    <div>
      <%= form.label :group_id, t('.labels.group_id'), class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= form.number_field :group_id, class: ["w-full rounded-lg border px-3 py-2", {"border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500": group_classifier_state.errors[:group_id].none?, "border-red-400 focus:outline-red-600": group_classifier_state.errors[:group_id].any?}] %>
    </div>

    <div>
      <%= form.label :spam_counts, t('.labels.spam_counts'), class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= form.textarea :spam_counts, rows: 4, class: ["w-full rounded-lg border px-3 py-2", {"border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500": group_classifier_state.errors[:spam_counts].none?, "border-red-400 focus:outline-red-600": group_classifier_state.errors[:spam_counts].any?}] %>
    </div>

    <div>
      <%= form.label :ham_counts, t('.labels.ham_counts'), class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= form.textarea :ham_counts, rows: 4, class: ["w-full rounded-lg border px-3 py-2", {"border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500": group_classifier_state.errors[:ham_counts].none?, "border-red-400 focus:outline-red-600": group_classifier_state.errors[:ham_counts].any?}] %>
    </div>

    <div>
      <%= form.label :total_spam_words, t('.labels.total_spam_words'), class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= form.number_field :total_spam_words, class: ["w-full rounded-lg border px-3 py-2", {"border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500": group_classifier_state.errors[:total_spam_words].none?, "border-red-400 focus:outline-red-600": group_classifier_state.errors[:total_spam_words].any?}] %>
    </div>

    <div>
      <%= form.label :total_ham_words, t('.labels.total_ham_words'), class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= form.number_field :total_ham_words, class: ["w-full rounded-lg border px-3 py-2", {"border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500": group_classifier_state.errors[:total_ham_words].none?, "border-red-400 focus:outline-red-600": group_classifier_state.errors[:total_ham_words].any?}] %>
    </div>

    <div>
      <%= form.label :total_spam_messages, t('.labels.total_spam_messages'), class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= form.number_field :total_spam_messages, class: ["w-full rounded-lg border px-3 py-2", {"border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500": group_classifier_state.errors[:total_spam_messages].none?, "border-red-400 focus:outline-red-600": group_classifier_state.errors[:total_spam_messages].any?}] %>
    </div>

    <div>
      <%= form.label :total_ham_messages, t('.labels.total_ham_messages'), class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= form.number_field :total_ham_messages, class: ["w-full rounded-lg border px-3 py-2", {"border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500": group_classifier_state.errors[:total_ham_messages].none?, "border-red-400 focus:outline-red-600": group_classifier_state.errors[:total_ham_messages].any?}] %>
    </div>

    <div>
      <%= form.label :vocabulary_size, t('.labels.vocabulary_size'), class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= form.number_field :vocabulary_size, class: ["w-full rounded-lg border px-3 py-2", {"border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500": group_classifier_state.errors[:vocabulary_size].none?, "border-red-400 focus:outline-red-600": group_classifier_state.errors[:vocabulary_size].any?}] %>
    </div>

  </div>
<% end %>
