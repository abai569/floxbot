<% content_for :title, t('.title') %>

<div class="w-full">
  <% if notice.present? %>
    <p class="py-2 px-3 bg-green-50 mb-5 text-green-500 font-medium rounded-lg inline-block text-sm" id="notice"><%= notice %></p>
  <% end %>

  <!-- Header -->
  <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center mb-6 gap-3">
    <div>
      <h1 class="font-bold text-2xl sm:text-3xl md:text-4xl mb-1"><%= t('.title') %></h1>
      <p class="text-gray-600 text-sm sm:text-base"><%= t('.showing', total: @total_count, start: (@page.to_i - 1) * @per_page + 1, end: [(@page.to_i - 1) * @per_page + @group_classifier_states.length, @total_count].min) %></p>
    </div>
    <%= link_to t('.new_button'), new_group_classifier_state_path, class: "w-full sm:w-auto text-center rounded-md px-4 py-2.5 bg-blue-600 hover:bg-blue-500 text-white block font-medium transition-colors duration-150" %>
  </div>

  <!-- Table -->
  <div class="hidden sm:block bg-white rounded-lg shadow-sm border border-gray-200 overflow-hidden">
    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
              <%= link_to group_classifier_states_path(params.permit!.merge(sort: 'id', direction: params[:sort] == 'id' && params[:direction] == 'asc' ? 'desc' : 'asc')), class: "hover:text-gray-700 flex items-center space-x-1" do %>
                 <span><%= t('.columns.id') %></span>
                 <% if params[:sort] == 'id' %>
                   <span><%= params[:direction] == 'asc' ? '↑' : '↓' %></span>
                 <% end %>
               <% end %>
             </th>

             <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
               <%= link_to group_classifier_states_path(params.permit!.merge(sort: 'group_name', direction: params[:sort] == 'group_name' && params[:direction] == 'asc' ? 'desc' : 'asc')), class: "hover:text-gray-700 flex items-center space-x-1" do %>
                 <span><%= t('.columns.group') %></span>
                <% if params[:sort] == 'group_name' %>
                  <span><%= params[:direction] == 'asc' ? '↑' : '↓' %></span>
                <% end %>
              <% end %>
            </th>

            <th scope="col" class="hidden md:table-cell px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
              <%= t('.columns.spam_words_count') %>
            </th>
            <th scope="col" class="hidden md:table-cell px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
              <%= t('.columns.ham_words_count') %>
            </th>

            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
              <%= t('.columns.total_spam_messages') %>
            </th>
            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
              <%= t('.columns.total_ham_messages') %>
            </th>
            <th scope="col" class="hidden lg:table-cell px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
              <%= t('.columns.vocabulary_size') %>
            </th>

            <th scope="col" class="hidden lg:table-cell px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
              <%= link_to group_classifier_states_path(params.permit!.merge(sort: 'created_at', direction: params[:sort] == 'created_at' && params[:direction] == 'asc' ? 'desc' : 'asc')), class: "hover:text-gray-700 flex items-center space-x-1" do %>
                <span><%= t('.columns.created') %></span>
                <% if params[:sort] == 'created_at' %>
                  <span><%= params[:direction] == 'asc' ? '↑' : '↓' %></span>
                <% end %>
              <% end %>
            </th>
              <th scope="col" class="hidden lg:table-cell px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">
                <%= link_to group_classifier_states_path(params.permit!.merge(sort: 'updated_at', direction: params[:sort] == 'updated_at' && params[:direction] == 'asc' ? 'desc' : 'asc')), class: "hover:text-gray-700 flex items-center space-x-1" do %>
                  <span><%= t('.columns.updated') %></span>
                  <% if params[:sort] == 'updated_at' %>
                    <span><%= params[:direction] == 'asc' ? '↑' : '↓' %></span>
                  <% end %>
                <% end %>
              </th>
              <th scope="col" class="relative px-6 py-3">
                <span class="sr-only"><%= t('.columns.actions') %></span>
              </th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200">
          <% if !@group_classifier_states.empty? %>
            <% @group_classifier_states.each do |group_classifier_state| %>
              <tr class="hover:bg-gray-50 transition-colors duration-150">
                <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">
                  <%= group_classifier_state.id %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                  <%= group_classifier_state.group_name || t('.private') %>
                </td>

                <td class="hidden md:table-cell px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">
                  <%= group_classifier_state.spam_counts.is_a?(Hash) ? group_classifier_state.spam_counts&.keys&.count || 0 : group_classifier_state.spam_counts %>
                </td>
                <td class="hidden md:table-cell px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">
                  <%= group_classifier_state.ham_counts.is_a?(Hash) ? group_classifier_state.ham_counts&.keys&.count || 0 : group_classifier_state.ham_counts %>
                </td>

                <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">
                  <%= group_classifier_state.total_spam_messages %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">
                  <%= group_classifier_state.total_ham_messages %>
                </td>
                <td class="hidden lg:table-cell px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">
                  <%= group_classifier_state.vocabulary_size %>
                </td>

                <td class="hidden lg:table-cell px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                  <%= display_time_ago(group_classifier_state.created_at) %>
                </td>

                <td class="hidden lg:table-cell px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                  <%= display_time_ago(group_classifier_state.updated_at) %>
                </td>

                <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                  <div class="action-group">
                    <%= link_to t('.actions.view'), group_classifier_state_path(group_classifier_state, request.query_parameters), class: "action-pill action-pill-primary" %>
                    <%= link_to t('.actions.edit'), edit_group_classifier_state_path(group_classifier_state), class: "action-pill" %>
                    <%= link_to t('.actions.delete'), group_classifier_state, method: :delete,
                        class: "action-pill action-pill-danger",
                        data: { turbo_confirm: t('.confirm') } %>
                  </div>
                </td>
              </tr>
            <% end %>
          <% else %>
            <tr>
              <td colspan="8" class="px-6 py-12 text-center text-gray-500">
                <div class="flex flex-col items-center">
                  <svg class="w-12 h-12 text-gray-300 mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path>
                  </svg>
                  <p><%= t('.no_results') %></p>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    </div>

  <div class="grid gap-3 sm:hidden">
    <% if !@group_classifier_states.empty? %>
      <% @group_classifier_states.each do |group_classifier_state| %>
        <article class="mobile-card p-4">
          <div class="flex items-start justify-between gap-3">
            <div class="min-w-0">
              <h2 class="truncate text-base font-black text-slate-950"><%= group_classifier_state.group_name || t('.private') %></h2>
              <p class="mt-1 text-xs text-slate-500">ID <%= group_classifier_state.id %></p>
            </div>
            <span class="badge-soft bg-blue-100 text-blue-700"><%= group_classifier_state.vocabulary_size %> words</span>
          </div>
          <div class="mt-4 grid grid-cols-2 gap-3">
            <div class="rounded-2xl bg-red-50 p-3">
              <p class="text-xs font-semibold text-red-600"><%= t('.columns.total_spam_messages') %></p>
              <p class="mt-1 text-xl font-black text-red-700"><%= group_classifier_state.total_spam_messages %></p>
            </div>
            <div class="rounded-2xl bg-green-50 p-3">
              <p class="text-xs font-semibold text-green-600"><%= t('.columns.total_ham_messages') %></p>
              <p class="mt-1 text-xl font-black text-green-700"><%= group_classifier_state.total_ham_messages %></p>
            </div>
          </div>
          <div class="mt-4 flex items-center justify-between border-t border-slate-100 pt-3">
            <span class="text-xs text-slate-500"><%= display_time_ago(group_classifier_state.updated_at) %></span>
            <div class="action-group">
              <%= link_to t('.actions.view'), group_classifier_state_path(group_classifier_state, request.query_parameters), class: "action-pill action-pill-primary" %>
              <%= link_to t('.actions.edit'), edit_group_classifier_state_path(group_classifier_state), class: "action-pill" %>
            </div>
          </div>
        </article>
      <% end %>
    <% else %>
      <div class="panel-card p-8 text-center text-sm text-slate-500"><%= t('.no_results') %></div>
    <% end %>
  </div>

  <!-- Pagination -->
  <% if @total_pages > 1 %>
    <div class="bg-white px-4 py-4 flex flex-col sm:flex-row items-center justify-between border-t border-gray-200 sm:px-6 mt-4 rounded-lg shadow-sm">
      <div class="flex-1 flex justify-between sm:hidden w-full">
        <% if @page > 1 %>
          <%= link_to t('.previous'), group_classifier_states_path(params.permit!.merge(page: @page - 1)),
              class: "relative inline-flex items-center px-4 py-2.5 rounded-lg border border-gray-300 text-sm font-medium text-gray-700 bg-white hover:bg-gray-50 transition-colors duration-150" %>
        <% end %>
        <% if @page < @total_pages %>
          <%= link_to t('.next'), group_classifier_states_path(params.permit!.merge(page: @page + 1)),
              class: "ml-3 relative inline-flex items-center px-4 py-2.5 rounded-lg border border-gray-300 text-sm font-medium text-gray-700 bg-white hover:bg-gray-50 transition-colors duration-150" %>
        <% end %>
      </div>
      <div class="hidden sm:flex sm:flex-1 sm:items-center sm:justify-between">
        <div class="text-sm text-gray-700 mb-3 sm:mb-0">
          <%= t('.showing_range', start: (@page.to_i - 1) * @per_page + 1, end: [(@page.to_i - 1) * @per_page + @group_classifier_states.length, @total_count].min, total: @total_count) %>
        </div>
        <div>
          <nav class="relative z-0 inline-flex rounded-lg shadow-sm -space-x-px" aria-label="Pagination">
            <% if @page > 1 %>
              <%= link_to group_classifier_states_path(params.permit!.merge(page: @page - 1)),
                  class: "relative inline-flex items-center px-3 py-2 rounded-l-lg border border-gray-300 bg-white text-sm font-medium text-gray-500 hover:bg-gray-100 transition-colors duration-150" do %>
                <svg class="h-5 w-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                  <path fill-rule="evenodd" d="M12.707 5.293a1 1 0 010 1.414L9.414 10l3.293 3.293a1 1 0 01-1.414 1.414l-4-4a1 1 0 010-1.414l4-4a1 1 0 011.414 0z" clip-rule="evenodd" />
                </svg>
                <span class="sr-only"><%= t('.previous') %></span>
              <% end %>
            <% else %>
              <span class="relative inline-flex items-center px-3 py-2 rounded-l-lg border border-gray-300 bg-gray-50 text-sm font-medium text-gray-300 cursor-not-allowed">
                <svg class="h-5 w-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                  <path fill-rule="evenodd" d="M12.707 5.293a1 1 0 010 1.414L9.414 10l3.293 3.293a1 1 0 01-1.414 1.414l-4-4a1 1 0 010-1.414l4-4a1 1 0 011.414 0z" clip-rule="evenodd" />
                </svg>
              </span>
            <% end %>

            <% start_page = [1, @page - 2].max %>
            <% end_page = [start_page + 4, @total_pages].min %>
            <% start_page = [end_page - 4, 1].max if end_page - start_page < 4 %>

            <% (start_page..end_page).each do |page_num| %>
              <% if page_num == @page %>
                <span class="relative inline-flex items-center px-4 py-2 border border-transparent bg-blue-100 text-blue-700 font-medium text-sm">
                  <%= page_num %>
                </span>
              <% else %>
                <%= link_to page_num, group_classifier_states_path(params.permit!.merge(page: page_num)),
                    class: "relative inline-flex items-center px-4 py-2 border border-gray-300 bg-white text-gray-700 text-sm font-medium hover:bg-gray-50 transition-colors duration-150" %>
              <% end %>
            <% end %>

            <% if @page < @total_pages %>
              <%= link_to group_classifier_states_path(params.permit!.merge(page: @page + 1)),
                  class: "relative inline-flex items-center px-3 py-2 rounded-r-lg border border-gray-300 bg-white text-sm font-medium text-gray-500 hover:bg-gray-100 transition-colors duration-150" do %>
                <span class="sr-only"><%= t('.next') %></span>
                <svg class="h-5 w-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                  <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd" />
                </svg>
              <% end %>
            <% else %>
              <span class="relative inline-flex items-center px-3 py-2 rounded-r-lg border border-gray-300 bg-gray-50 text-sm font-medium text-gray-300 cursor-not-allowed">
                <svg class="h-5 w-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                  <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd" />
                </svg>
              </span>
            <% end %>
          </nav>
        </div>
      </div>
    </div>
  <% end %>
</div>
