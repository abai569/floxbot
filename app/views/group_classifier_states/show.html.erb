<% content_for :title, t('.title') %>
 
<div class="w-full max-w-5xl mx-auto space-y-6">
  <% if notice.present? %>
    <p class="py-2 px-3 bg-green-50 mb-5 text-green-500 font-medium rounded-md inline-block" id="notice"><%= notice %></p>
  <% end %>
 
  <div>
    <p class="text-sm font-semibold uppercase tracking-[0.18em] text-blue-600"><%= t('layout.group_classifiers') %></p>
    <h1 class="page-title mt-2"><%= t('.title') %></h1>
  </div>
 
  <div class="w-full my-5 space-y-5">
    <!-- Basic Information -->
    <div class="bg-white p-6 rounded-lg shadow-md border border-gray-200">
      <h2 class="text-xl font-bold mb-4"><%= t('.basic_info') %></h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
        <div>
          <strong class="block font-medium mb-1"><%= t('.group_id') %>:</strong>
          <%= @group_classifier_state.group_id %>
        </div>
        <div>
          <strong class="block font-medium mb-1"><%= t('.group_name') %>:</strong>
          <%= @group_classifier_state.group_name %>
        </div>
        <div>
          <strong class="block font-medium mb-1"><%= t('.total_spam_messages') %>:</strong>
          <%= @group_classifier_state.total_spam_messages %>
        </div>
        <div>
          <strong class="block font-medium mb-1"><%= t('.total_ham_messages') %>:</strong>
          <%= @group_classifier_state.total_ham_messages %>
        </div>
      </div>
    </div>
 
    <!-- Summary Statistics -->
    <div class="bg-white p-6 rounded-lg shadow-md border border-gray-200">
      <h2 class="text-xl font-bold mb-4"><%= t('.classifier_summary') %></h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <div class="bg-blue-50 p-4 rounded-lg">
          <div class="text-sm text-blue-800 font-medium"><%= t('.total_vocabulary') %></div>
          <div class="text-2xl font-bold text-blue-600"><%= @group_classifier_state.vocabulary_size %></div>
        </div>
        <div class="bg-red-50 p-4 rounded-lg">
          <div class="text-sm text-red-800 font-medium"><%= t('.total_spam_words') %></div>
          <div class="text-2xl font-bold text-red-600"><%= @group_classifier_state.total_spam_words_count %></div>
        </div>
        <div class="bg-green-50 p-4 rounded-lg">
          <div class="text-sm text-green-800 font-medium"><%= t('.total_ham_words') %></div>
          <div class="text-2xl font-bold text-green-600"><%= @group_classifier_state.total_ham_words_count %></div>
        </div>
      </div>
    </div>
 
    <!-- K Value Selector -->
    <div class="bg-white p-6 rounded-lg shadow-md border border-gray-200">
      <h2 class="text-xl font-bold mb-4"><%= t('.top_words_analysis') %></h2>
      <div class="mb-4">
        <label for="kValue" class="block text-sm font-medium text-gray-700 mb-2"><%= t('.select_count') %></label>
        <%= form_with url: group_classifier_state_path(@group_classifier_state), method: :get, local: true, class: "flex items-center space-x-3" do |form| %>
          <%= form.number_field :k, value: @k_value || 20, min: 5, max: 50, class: "w-24 px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-indigo-500 focus:border-indigo-500" %>
          <%= form.submit t('.update_button'), class: "inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-indigo-600 hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500" %>
        <% end %>
      </div>
 
      <!-- Top Spam Words -->
      <div class="mb-8">
        <h3 class="text-lg font-semibold mb-3 text-red-600"><%= t('.top_spam_words', count: @k_value || 20) %></h3>
        <div class="overflow-x-auto">
          <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-50">
              <tr>
                <th scope="col" class="px-3 py-2 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"><%= t('.columns.rank') %></th>
                <th scope="col" class="px-3 py-2 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"><%= t('.columns.word') %></th>
                <th scope="col" class="px-3 py-2 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"><%= t('.columns.count') %></th>
              </tr>
            </thead>
            <tbody class="bg-white divide-y divide-gray-200">
              <% @group_classifier_state.top_spam_words(@k_value || 20).each_with_index do |(word, count), index| %>
                <tr>
                  <td class="px-3 py-2 whitespace-nowrap text-sm font-medium text-gray-500"><%= index + 1 %></td>
                  <td class="px-3 py-2 whitespace-nowrap text-sm font-medium text-gray-900"><%= word %></td>
                  <td class="px-3 py-2 whitespace-nowrap text-sm text-gray-500"><%= count %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
 
      <!-- Top Ham Words -->
      <div>
        <h3 class="text-lg font-semibold mb-3 text-green-600"><%= t('.top_ham_words', count: @k_value || 20) %></h3>
        <div class="overflow-x-auto">
          <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-50">
              <tr>
                <th scope="col" class="px-3 py-2 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"><%= t('.columns.rank') %></th>
                <th scope="col" class="px-3 py-2 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"><%= t('.columns.word') %></th>
                <th scope="col" class="px-3 py-2 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"><%= t('.columns.count') %></th>
              </tr>
            </thead>
            <tbody class="bg-white divide-y divide-gray-200">
              <% @group_classifier_state.top_ham_words(@k_value || 20).each_with_index do |(word, count), index| %>
                <tr>
                  <td class="px-3 py-2 whitespace-nowrap text-sm font-medium text-gray-500"><%= index + 1 %></td>
                  <td class="px-3 py-2 whitespace-nowrap text-sm font-medium text-gray-900"><%= word %></td>
                  <td class="px-3 py-2 whitespace-nowrap text-sm text-gray-500"><%= count %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
 
  <div class="flex flex-col justify-end gap-2 sm:flex-row sm:gap-3">
    <%= link_to t('.edit_link'), edit_group_classifier_state_path(@group_classifier_state), class: "w-full sm:w-auto text-center rounded-xl bg-blue-600 px-4 py-2.5 font-semibold text-white shadow-lg shadow-blue-500/20 hover:bg-blue-700" %>
    <%= link_to t('.back_link'), group_classifier_states_path(index_params), class: "w-full sm:w-auto text-center rounded-xl border border-slate-200 bg-white px-4 py-2.5 font-semibold text-slate-700 hover:bg-slate-50" %>
    <%= button_to t('.delete_link'), @group_classifier_state, method: :delete, form_class: "sm:inline-block", class: "w-full sm:w-auto rounded-xl border border-red-200 bg-red-50 px-4 py-2.5 font-semibold text-red-700 hover:bg-red-100 cursor-pointer", data: { turbo_confirm: t('.confirm') } %>
  </div>
</div>
