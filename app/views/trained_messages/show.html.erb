<% content_for :title, t('.title') %>

<div class="w-full max-w-5xl mx-auto space-y-6">
  <% if notice.present? %>
    <p class="py-2 px-3 bg-green-50 mb-5 text-green-500 font-medium rounded-md inline-block" id="notice"><%= notice %></p>
  <% end %>

  <div>
    <p class="text-sm font-semibold uppercase tracking-[0.18em] text-blue-600"><%= t('layout.trained_messages') %></p>
    <h1 class="page-title mt-2"><%= t('.title') %></h1>
  </div>

  <%= render @trained_message %>

  <div class="flex flex-col justify-end gap-2 sm:flex-row sm:gap-3">
    <%= link_to t('.edit_link'), edit_trained_message_path(@trained_message), class: "w-full sm:w-auto text-center rounded-xl bg-blue-600 px-4 py-2.5 font-semibold text-white shadow-lg shadow-blue-500/20 hover:bg-blue-700" %>
    <%= link_to t('.back_link'), trained_messages_path(index_params), class: "w-full sm:w-auto text-center rounded-xl border border-slate-200 bg-white px-4 py-2.5 font-semibold text-slate-700 hover:bg-slate-50" %>
    <%= button_to t('.delete_link'), @trained_message, method: :delete, form_class: "sm:inline-block", class: "w-full sm:w-auto rounded-xl border border-red-200 bg-red-50 px-4 py-2.5 font-semibold text-red-700 hover:bg-red-100 cursor-pointer transition-colors duration-150", data: { turbo_confirm: t('.confirm') }, params: { return_url: params[:return_url] || trained_messages_path(index_params) } %>
  </div>
</div>
