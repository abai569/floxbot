<div id="<%= dom_id trained_message %>" class="bg-white p-6 rounded-lg shadow-sm border border-gray-200 space-y-4">
  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
    <div>
      <strong class="block text-sm font-medium text-gray-700 mb-1"><%= t('.group') %>:</strong>
      <span class="text-sm"><%= trained_message.group_id %></span>
    </div>
    <div>
      <strong class="block text-sm font-medium text-gray-700 mb-1"><%= t('.group_name') %>:</strong>
      <span class="text-sm"><%= trained_message.group_name %></span>
    </div>
    <div>
      <strong class="block text-sm font-medium text-gray-700 mb-1"><%= t('.message_type') %>:</strong>
      <span class="text-sm"><%= trained_message.message_type %></span>
    </div>
    <div>
      <strong class="block text-sm font-medium text-gray-700 mb-1"><%= t('.training_target') %>:</strong>
      <span class="text-sm"><%= trained_message.training_target %></span>
    </div>
    <div>
      <strong class="block text-sm font-medium text-gray-700 mb-1"><%= t('.source') %>:</strong>
      <span class="text-sm"><%= trained_message.source %></span>
    </div>
    <div>
      <strong class="block text-sm font-medium text-gray-700 mb-1"><%= t('.marked_by') %>:</strong>
      <span class="text-sm"><%= trained_message.marked_by&.humanize || t('.unknown') %></span>
    </div>
    <div>
      <strong class="block text-sm font-medium text-gray-700 mb-1"><%= t('.sender_chat_id') %>:</strong>
      <span class="text-sm"><%= trained_message.sender_chat_id %></span>
    </div>
    <div>
      <strong class="block text-sm font-medium text-gray-700 mb-1"><%= t('.sender_user_name') %>:</strong>
      <span class="text-sm"><%= trained_message.sender_user_name %></span>
    </div>
    <div>
      <strong class="block text-sm font-medium text-gray-700 mb-1"><%= t('.telegram_message_id') %>:</strong>
      <span class="text-sm"><%= trained_message.message_id %></span>
    </div>
    <div>
      <strong class="block text-sm font-medium text-gray-700 mb-1"><%= t('.message_hash') %>:</strong>
      <span class="text-sm font-mono text-xs"><%= trained_message.message_hash %></span>
    </div>
    <div>
      <strong class="block text-sm font-medium text-gray-700 mb-1"><%= t('.created_at') %>:</strong>
      <span class="text-sm"><%= trained_message.created_at.strftime("%Y-%m-%d %H:%M") %></span>
    </div>
  </div>
  <div>
    <strong class="block text-sm font-medium text-gray-700 mb-1"><%= t('.message') %>:</strong>
    <div class="bg-gray-50 p-3 rounded-lg text-sm break-all mt-1"><%= trained_message.message %></div>
  </div>
</div>
