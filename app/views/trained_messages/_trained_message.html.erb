<div id="<%= dom_id trained_message %>" class="w-full sm:w-auto my-5 space-y-5">
  <div>
    <strong class="block font-medium mb-1"><%= t('.group') %>:</strong>
    <%= trained_message.group_id %>
  </div>
  <div>
    <strong class="block font-medium mb-1"><%= t('.group_name') %>:</strong>
    <%= trained_message.group_name %>
  </div>
  <div>
    <strong class="block font-medium mb-1"><%= t('.message') %>:</strong>
    <%= trained_message.message %>
  </div>
  <div>
    <strong class="block font-medium mb-1"><%= t('.message_type') %>:</strong>
    <%= trained_message.message_type %>
  </div>

  <div>
    <strong class="block font-medium mb-1"><%= t('.telegram_message_id') %>:</strong>
    <%= trained_message.message_id %>
  </div>

  <div>
    <strong class="block font-medium mb-1"><%= t('.message_hash') %>:</strong>
    <%= trained_message.message_hash %>
  </div>
  <div>
    <strong class="block font-medium mb-1"><%= t('.training_target') %>:</strong>
    <%= trained_message.training_target %>
  </div>
  <div>
    <strong class="block font-medium mb-1"><%= t('.source') %>:</strong>
    <%= trained_message.source %>
  </div>
  <div>
    <strong class="block font-medium mb-1"><%= t('.marked_by') %>:</strong>
    <%= trained_message.marked_by&.humanize || t('.unknown') %>
  </div>
  <div>
    <strong class="block font-medium mb-1"><%= t('.sender_chat_id') %>:</strong>
    <%= trained_message.sender_chat_id %>
  </div>

  <div>
    <strong class="block font-medium mb-1"><%= t('.sender_user_name') %>:</strong>
    <%= trained_message.sender_user_name %>
  </div>
  <div>
    <strong class="block font-medium mb-1"><%= t('.created_at') %>:</strong>
    <%= trained_message.created_at.strftime("%Y-%m-%d %H:%M") %>
  </div>
</div>
