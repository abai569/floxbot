<%= form_with(model: trained_message, class: "space-y-6", id: "trained-message-form") do |form| %>
  <% if trained_message.errors.any? %>
    <div id="error_explanation" class="bg-red-50 text-red-500 px-3 py-2 font-medium rounded-md mt-3">
      <h2><%= t('.error_header', count: trained_message.errors.count) %></h2>

      <ul class="list-disc ml-6">
        <% trained_message.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="bg-white p-6 rounded-lg shadow-md border border-gray-200 space-y-5">
    <div>
      <%= form.label :group_id, class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= form.number_field :group_id, class: ["w-full rounded-lg border px-3 py-2", {"border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500": trained_message.errors[:group_id].none?, "border-red-400 focus:outline-red-600": trained_message.errors[:group_id].any?}] %>
    </div>

    <div>
      <%= form.label :message, class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= form.textarea :message, rows: 4, class: ["w-full rounded-lg border px-3 py-2", {"border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500": trained_message.errors[:message].none?, "border-red-400 focus:outline-red-600": trained_message.errors[:message].any?}] %>
    </div>

    <div>
      <%= form.label :message_type, class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= form.select :message_type,
            options_for_select([[t('.options.spam'), 'spam'], [t('.options.ham'), 'ham'], [t('.options.untrained'), 'untrained']], @trained_message.message_type),
            { prompt: t('.placeholders.message_type') },
         { class: ["w-full rounded-lg border px-3 py-2", {"border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500": trained_message.errors[:message_type].none?, "border-red-400 focus:outline-red-600": trained_message.errors[:message_type].any?}] } %>
    </div>

    <div>
      <%= form.label :training_target, class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= form.select :training_target,
            options_for_select([[t('.options.message_content'), 'message_content'], [t('.options.username'), 'user_name']], @trained_message.training_target),
            { prompt: t('.placeholders.training_target') },
         { class: ["w-full rounded-lg border px-3 py-2", {"border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500": trained_message.errors[:training_target].none?, "border-red-400 focus:outline-red-600": trained_message.errors[:training_target].any?}] } %>
    </div>

    <div>
      <%= form.label :source, class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= form.select :source,
            options_for_select([[t('.options.chat'), 'chat'], [t('.options.feedspam'), 'feedspam_command'], [t('.options.import'), 'import']], @trained_message.source),
            { prompt: t('.placeholders.source') },
         { class: ["w-full rounded-lg border px-3 py-2", {"border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500": trained_message.errors[:source].none?, "border-red-400 focus:outline-red-600": trained_message.errors[:source].any?}] } %>
    </div>

    <div>
        <%= form.label :marked_by, class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= form.select :marked_by,
         options_for_select([[t('.options.group_admin'), 'group_admin'], [t('.options.admin_dashboard'), 'admin_dashboard'], [t('.options.auto_sync'), 'auto_sync'], [t('.options.not_marked_yet'), 'not_marked_yet']], @trained_message.marked_by),
         { prompt: t('.placeholders.marked_by') },
         { class: ["w-full rounded-lg border px-3 py-2", {"border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500": trained_message.errors[:marked_by].none?, "border-red-400 focus:outline-red-600": trained_message.errors[:marked_by].any?}] } %>
    </div>

    <div>
      <%= form.label :sender_chat_id, class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= form.number_field :sender_chat_id, class: ["w-full rounded-lg border px-3 py-2", {"border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500": trained_message.errors[:sender_chat_id].none?, "border-red-400 focus:outline-red-600": trained_message.errors[:sender_chat_id].any?}] %>
    </div>

  </div>
<% end %>
