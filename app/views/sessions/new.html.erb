<%= content_for(:title, t('.title')) %>

<div class="min-h-screen px-4 py-10 sm:px-6 lg:px-8 flex items-center justify-center">
  <div class="w-full max-w-sm">
    <div class="mb-7 text-center">
      <div class="mx-auto mb-4 flex h-14 w-14 items-center justify-center rounded-3xl bg-gradient-to-br from-blue-600 to-indigo-600 text-xl font-black text-white shadow-xl shadow-blue-500/25">F</div>
      <h1 class="page-title"><%= t('.heading') %></h1>
      <p class="page-subtitle">管理入群验证、广告拦截、训练数据和群组配置</p>
    </div>

    <div class="panel-card p-6 sm:p-8">
      <div class="mb-6 rounded-2xl border border-blue-100 bg-blue-50/70 p-4 text-sm text-blue-800">
        登录后可以查看拦截记录、训练模型并调整每个群的自动化策略。
      </div>

    <% if flash[:alert] %>
      <div class="mb-4 rounded-2xl border border-red-200 bg-red-50 px-4 py-3 text-sm font-medium text-red-700">
        <%= flash[:alert] %>
      </div>
    <% end %>

    <%= form_with url: login_path, class: "space-y-5" do |f| %>
      <div>
        <%= f.label :username, t('.username'), class: "block text-sm font-semibold text-slate-700 mb-1.5" %>
        <%= f.text_field :username, autofocus: true, required: true,
            class: "w-full px-4 py-2.5" %>
      </div>

      <div>
        <%= f.label :password, t('.password'), class: "block text-sm font-semibold text-slate-700 mb-1.5" %>
        <%= f.password_field :password, required: true,
            class: "w-full px-4 py-2.5" %>
      </div>

      <div>
        <%= f.submit t('.submit'), class: "w-full cursor-pointer px-4 py-3 font-semibold text-white" %>
      </div>
    <% end %>
    </div>
  </div>
</div>
