<div class="w-full">
  <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center mb-6 gap-3">
    <h1 class="font-bold text-2xl sm:text-3xl md:text-4xl"><%= t('.title') %></h1>
    <%= link_to t('.get_samples'),
                new_tokenization_sample_path,
                data: { turbo_frame: "sample" },
                class: "w-full sm:w-auto text-center rounded-lg px-4 py-2.5 bg-blue-600 hover:bg-blue-700 text-white font-medium transition-colors duration-150" %>
  </div>

  <turbo-frame id="sample">
    <% if @samples.any? %>
      <% @samples.each_with_index do |sample, index| %>
        <div class="mt-6 p-4 sm:p-6 border border-gray-200 rounded-lg shadow-sm bg-white">
          <h2 class="text-lg font-bold mb-4"><%= t('.sample', number: index + 1) %></h2>

          <div class="space-y-4">
            <div>
              <h3 class="text-sm font-medium text-gray-700 mb-1"><%= t('.original_message') %></h3>
              <p class="bg-gray-50 p-3 rounded-lg text-sm break-all"><%= sample[:original] %></p>
            </div>

            <div>
              <h3 class="text-sm font-medium text-gray-700 mb-1"><%= t('.cleaned_message') %></h3>
              <p class="bg-gray-50 p-3 rounded-lg text-sm break-all"><%= sample[:cleaned] %></p>
            </div>

            <div>
              <h3 class="text-sm font-medium text-gray-700 mb-1"><%= t('.tokens') %></h3>
              <div class="bg-gray-50 p-3 rounded-lg flex flex-wrap gap-2">
                <% sample[:tokens].each do |token| %>
                  <span class="inline-block bg-white border border-gray-200 rounded-full px-3 py-1 text-sm text-gray-700">
                    <%= token %>
                  </span>
                <% end %>
              </div>
            </div>
          </div>
        </div>
      <% end %>
    <% else %>
      <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-8 text-center text-gray-500">
        <p><%= t('.no_data') %></p>
      </div>
    <% end %>
  </turbo-frame>
</div>
