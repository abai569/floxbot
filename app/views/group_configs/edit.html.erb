<% content_for :title, t('.title') %>

<div class="w-full max-w-5xl mx-auto space-y-6">
  <div>
    <p class="text-sm font-semibold uppercase tracking-[0.18em] text-blue-600"><%= t('layout.group_configs') %></p>
    <h1 class="page-title mt-2"><%= t('.title') %></h1>
    <p class="page-subtitle">调整入群验证、欢迎语和消息清理策略。</p>
  </div>

  <%= render "form", group_config: @group_config %>

  <div class="flex flex-col justify-end gap-2 sm:flex-row sm:gap-3">
    <button type="submit" form="group-config-form" class="w-full rounded-xl bg-blue-600 px-4 py-2.5 text-center text-sm font-semibold text-white shadow-lg shadow-blue-500/20 hover:bg-blue-700 sm:w-auto">更新</button>
    <%= link_to t('.show_link'), @group_config, class: "w-full rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-center text-sm font-semibold text-slate-700 hover:bg-slate-50 sm:w-auto" %>
    <%= link_to t('.back_link'), group_configs_path, class: "w-full rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-center text-sm font-semibold text-slate-700 hover:bg-slate-50 sm:w-auto" %>
  </div>
</div>
