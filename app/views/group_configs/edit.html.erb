<% content_for :title, t('.title') %>

<div class="md:w-2/3 w-full">
  <h1 class="font-bold text-2xl sm:text-3xl md:text-4xl mb-6"><%= t('.title') %></h1>

  <%= render "form", group_config: @group_config %>

  <div class="flex flex-col sm:flex-row gap-2 sm:gap-3 mt-6">
    <%= link_to t('.show_link'), @group_config, class: "w-full sm:w-auto text-center rounded-lg px-4 py-2.5 bg-gray-100 hover:bg-gray-50 inline-block font-medium transition-colors duration-150" %>
    <%= link_to t('.back_link'), group_configs_path, class: "w-full sm:w-auto text-center rounded-lg px-4 py-2.5 bg-gray-100 hover:bg-gray-50 inline-block font-medium transition-colors duration-150" %>
  </div>
</div>
