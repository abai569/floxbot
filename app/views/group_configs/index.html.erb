<% content_for :title, t('.title') %>

<div class="w-full">
  <% if notice.present? %>
    <p class="py-2 px-3 bg-green-50 mb-5 text-green-500 font-medium rounded-lg inline-block text-sm" id="notice"><%= notice %></p>
  <% end %>

  <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center mb-6 gap-3">
    <h1 class="font-bold text-2xl sm:text-3xl md:text-4xl"><%= t('.title') %></h1>
    <%= link_to t('.new_button'), new_group_config_path, class: "w-full sm:w-auto text-center rounded-lg px-4 py-2.5 bg-blue-600 hover:bg-blue-700 text-white font-medium transition-colors duration-150" %>
  </div>

  <div class="bg-white rounded-lg shadow-sm border border-gray-200 overflow-hidden">
    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"><%= t('.columns.group') %></th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"><%= t('.columns.verify') %></th>
            <th class="hidden md:table-cell px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"><%= t('.columns.welcome') %></th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"><%= t('.columns.cleanup') %></th>
            <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider"><%= t('.columns.actions') %></th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200">
          <% @group_configs.each do |config| %>
            <tr class="hover:bg-gray-50 transition-colors duration-150">
              <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">
                <%= config.group_name || config.group_id %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm">
                <% if config.none? %>
                  <span class="text-gray-400"><%= t('.badges.disabled') %></span>
                <% elsif config.button? %>
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800"><%= t('.badges.button') %></span>
                <% elsif config.math? %>
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-purple-100 text-purple-800"><%= t('.badges.math') %></span>
                <% end %>
              </td>
              <td class="hidden md:table-cell px-6 py-4 text-sm text-gray-500 max-w-xs truncate">
                <%= config.welcome_text.present? ? truncate(config.welcome_text, length: 40) : "—" %>
                <%= " 📷" if config.welcome_photo_id.present? %>
                <%= " 🎬" if config.welcome_video_id.present? %>
                <%= " 🔘" if config.welcome_buttons.present? %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm">
                <div class="flex space-x-1">
                  <%= tag.span t('.badges.fwd'), class: "px-1.5 py-0.5 rounded text-xs #{config.del_forward? ? 'bg-green-100 text-green-700' : 'bg-gray-100 text-gray-500'}" %>
                  <%= tag.span t('.badges.kw'), class: "px-1.5 py-0.5 rounded text-xs #{config.del_keyword? ? 'bg-green-100 text-green-700' : 'bg-gray-100 text-gray-500'}" %>
                </div>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                <div class="flex items-center justify-end space-x-2">
                  <%= link_to t('.actions.view'), group_config_path(config), class: "text-indigo-600 hover:text-indigo-900 transition-colors duration-150" %>
                  <%= link_to t('.actions.edit'), edit_group_config_path(config), class: "text-indigo-600 hover:text-indigo-900 transition-colors duration-150" %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>

  <% if @total_pages > 1 %>
    <div class="bg-white px-4 py-4 flex flex-col sm:flex-row items-center justify-between border-t border-gray-200 sm:px-6 mt-4 rounded-lg shadow-sm">
      <div class="text-sm text-gray-700 mb-3 sm:mb-0">
        <%= t('.showing_range', start: (@page - 1) * @per_page + 1, end: [@page * @per_page, @total_count].min, total: @total_count) %>
      </div>
      <div class="flex space-x-2">
        <% if @page > 1 %>
          <%= link_to t('.previous'), group_configs_path(page: @page - 1), class: "px-4 py-2 border border-gray-300 rounded-lg text-sm font-medium text-gray-700 bg-white hover:bg-gray-50 transition-colors duration-150" %>
        <% end %>
        <% if @page < @total_pages %>
          <%= link_to t('.next'), group_configs_path(page: @page + 1), class: "px-4 py-2 border border-gray-300 rounded-lg text-sm font-medium text-gray-700 bg-white hover:bg-gray-50 transition-colors duration-150" %>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
