<% content_for :title, t('.title') %>

<div class="w-full space-y-6">
  <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <p class="text-sm font-semibold uppercase tracking-[0.18em] text-blue-600"><%= t('layout.group_configs') %></p>
      <h1 class="page-title mt-2"><%= t('.title') %></h1>
      <p class="page-subtitle">集中管理每个群的验证、欢迎消息和清理策略。</p>
    </div>
    <%= link_to t('.new_button'), new_group_config_path, class: "w-full sm:w-auto text-center rounded-xl px-5 py-3 bg-blue-600 text-white font-semibold" %>
  </div>

  <div class="hidden overflow-hidden rounded-2xl border border-slate-200 bg-white/90 shadow-sm sm:block">
    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-slate-200">
        <thead class="bg-slate-50">
          <tr>
            <th class="px-6 py-4 text-left text-xs font-bold uppercase tracking-wider text-slate-500"><%= t('.columns.group') %></th>
            <th class="px-6 py-4 text-left text-xs font-bold uppercase tracking-wider text-slate-500"><%= t('.columns.verify') %></th>
            <th class="hidden px-6 py-4 text-left text-xs font-bold uppercase tracking-wider text-slate-500 md:table-cell"><%= t('.columns.welcome') %></th>
            <th class="px-6 py-4 text-left text-xs font-bold uppercase tracking-wider text-slate-500"><%= t('.columns.cleanup') %></th>
            <th class="px-6 py-4 text-right text-xs font-bold uppercase tracking-wider text-slate-500"><%= t('.columns.actions') %></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100 bg-white/80">
          <% @group_configs.each do |config| %>
            <% cleanup_values = [] %>
            <% cleanup_values << config.alert_delete_delay.to_i %>
            <% cleanup_values << config.keyword_delete_delay.to_i %>
            <% cleanup_values << config.forward_delete_delay.to_i if GroupConfig.column_names.include?('forward_delete_delay') %>
            <% cleanup_values << config.welcome_delete_delay.to_i if GroupConfig.column_names.include?('welcome_delete_delay') %>
            <tr>
              <td class="px-6 py-5">
                <div class="font-bold text-slate-950"><%= config.group_name || config.group_id %></div>
                <div class="mt-1 text-xs text-slate-500"><%= config.group_id %></div>
              </td>
              <td class="px-6 py-5 text-sm">
                <% if config.none? %>
                  <span class="badge-soft bg-slate-100 text-slate-600"><%= t('.badges.disabled') %></span>
                <% elsif config.button? %>
                  <span class="badge-soft bg-blue-100 text-blue-700"><%= t('.badges.button') %></span>
                <% elsif config.math? %>
                  <span class="badge-soft bg-purple-100 text-purple-700"><%= t('.badges.math') %></span>
                <% end %>
              </td>
              <td class="hidden max-w-sm px-6 py-5 text-sm text-slate-600 md:table-cell">
                <div class="truncate"><%= config.welcome_text.present? ? truncate(config.welcome_text, length: 56) : "未设置欢迎语" %></div>
                <div class="mt-2 flex gap-1 text-xs">
                  <%= tag.span "图片", class: "badge-soft bg-slate-100 text-slate-600" if config.welcome_photo_id.present? %>
                  <%= tag.span "视频", class: "badge-soft bg-slate-100 text-slate-600" if config.welcome_video_id.present? %>
                  <%= tag.span "按钮", class: "badge-soft bg-slate-100 text-slate-600" if config.welcome_buttons.present? %>
                </div>
              </td>
              <td class="px-6 py-5 text-sm">
                <% active_cleanup = cleanup_values.count { |value| value > 0 } %>
                <span class="badge-soft <%= active_cleanup.positive? ? 'bg-green-100 text-green-700' : 'bg-slate-100 text-slate-600' %>">
                  <%= active_cleanup.positive? ? "#{active_cleanup} 项启用" : "全部保留" %>
                </span>
              </td>
              <td class="px-6 py-5 text-right text-sm font-semibold">
                <div class="action-group">
                  <%= link_to t('.actions.view'), group_config_path(config), class: "action-pill action-pill-primary" %>
                  <%= link_to t('.actions.edit'), edit_group_config_path(config), class: "action-pill" %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>

  <div class="grid gap-3 sm:hidden">
    <% @group_configs.each do |config| %>
      <% cleanup_values = [] %>
      <% cleanup_values << config.alert_delete_delay.to_i %>
      <% cleanup_values << config.keyword_delete_delay.to_i %>
      <% cleanup_values << config.forward_delete_delay.to_i if GroupConfig.column_names.include?('forward_delete_delay') %>
      <% cleanup_values << config.welcome_delete_delay.to_i if GroupConfig.column_names.include?('welcome_delete_delay') %>
      <% active_cleanup = cleanup_values.count { |value| value > 0 } %>
      <article class="mobile-card p-4">
        <div class="flex items-start justify-between gap-3">
          <div class="min-w-0">
            <h2 class="truncate text-base font-black text-slate-950"><%= config.group_name || config.group_id %></h2>
            <p class="mt-1 text-xs text-slate-500"><%= config.group_id %></p>
          </div>
          <% if config.none? %>
            <span class="badge-soft bg-slate-100 text-slate-600"><%= t('.badges.disabled') %></span>
          <% elsif config.button? %>
            <span class="badge-soft bg-blue-100 text-blue-700"><%= t('.badges.button') %></span>
          <% elsif config.math? %>
            <span class="badge-soft bg-purple-100 text-purple-700"><%= t('.badges.math') %></span>
          <% end %>
        </div>
        <p class="mt-3 line-clamp-2 text-sm text-slate-600"><%= config.welcome_text.present? ? truncate(config.welcome_text, length: 90) : "未设置欢迎语" %></p>
        <div class="mt-4 flex items-center justify-between gap-3 border-t border-slate-100 pt-3">
          <span class="badge-soft <%= active_cleanup.positive? ? 'bg-green-100 text-green-700' : 'bg-slate-100 text-slate-600' %>">
            <%= active_cleanup.positive? ? "#{active_cleanup} 项清理" : "不自动清理" %>
          </span>
          <div class="action-group">
            <%= link_to t('.actions.view'), group_config_path(config), class: "action-pill action-pill-primary" %>
            <%= link_to t('.actions.edit'), edit_group_config_path(config), class: "action-pill" %>
          </div>
        </div>
      </article>
    <% end %>
  </div>

  <% if @total_pages > 1 %>
    <div class="panel-card px-4 py-4 flex flex-col sm:flex-row items-center justify-between gap-3">
      <div class="text-sm text-slate-600">
        <%= t('.showing_range', start: (@page - 1) * @per_page + 1, end: [@page * @per_page, @total_count].min, total: @total_count) %>
      </div>
      <div class="flex w-full gap-2 sm:w-auto">
        <% if @page > 1 %>
          <%= link_to t('.previous'), group_configs_path(page: @page - 1), class: "flex-1 sm:flex-none text-center px-4 py-2 border border-slate-200 rounded-xl text-sm font-semibold text-slate-700 bg-white hover:bg-slate-50" %>
        <% end %>
        <% if @page < @total_pages %>
          <%= link_to t('.next'), group_configs_path(page: @page + 1), class: "flex-1 sm:flex-none text-center px-4 py-2 border border-slate-200 rounded-xl text-sm font-semibold text-slate-700 bg-white hover:bg-slate-50" %>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
