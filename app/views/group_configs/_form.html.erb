<%= form_with(model: group_config, class: "space-y-6", id: "group-config-form") do |form| %>
  <% if group_config.errors.any? %>
    <div class="rounded-2xl border border-red-200 bg-red-50 px-4 py-3 text-red-700">
      <h2 class="font-bold"><%= t('.error_header') %></h2>
      <ul class="mt-2 list-disc space-y-1 pl-5 text-sm">
        <% group_config.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <section class="panel-card overflow-hidden">
    <div class="border-b border-slate-200/70 px-5 py-4 sm:px-6">
      <h2 class="text-lg font-black text-slate-950">群组信息</h2>
      <p class="mt-1 text-sm text-slate-500">基础绑定信息，通常只需要确认群组名称是否正确。</p>
    </div>
    <div class="grid grid-cols-1 gap-5 p-5 sm:p-6 md:grid-cols-2">
      <div>
        <%= form.label :group_id, class: "mb-1.5 block text-sm font-semibold text-slate-700" %>
        <%= form.number_field :group_id, class: "w-full px-3 py-2" %>
      </div>
      <div>
        <%= form.label :group_name, class: "mb-1.5 block text-sm font-semibold text-slate-700" %>
        <%= form.text_field :group_name, class: "w-full px-3 py-2" %>
      </div>
    </div>
  </section>

  <section class="panel-card overflow-hidden">
    <div class="border-b border-slate-200/70 px-5 py-4 sm:px-6">
      <h2 class="text-lg font-black text-slate-950"><%= t('.verification') %></h2>
      <p class="mt-1 text-sm text-slate-500">控制新人入群是否需要按钮或数学验证。</p>
    </div>
    <div class="grid grid-cols-1 gap-5 p-5 sm:p-6 md:grid-cols-2">
      <div>
        <%= form.label :verification_mode, class: "mb-1.5 block text-sm font-semibold text-slate-700" %>
        <%= form.select :verification_mode,
            options_for_select([[t('.verification_modes.none'), "none"], [t('.verification_modes.button'), "button"], [t('.verification_modes.math'), "math"]], group_config.verification_mode),
            {}, class: "w-full px-3 py-2" %>
      </div>
      <div>
        <%= form.label :verification_timeout, t('.labels.verification_timeout'), class: "mb-1.5 block text-sm font-semibold text-slate-700" %>
        <%= form.number_field :verification_timeout, class: "w-full px-3 py-2" %>
        <p class="mt-1 text-xs text-slate-500">单位：秒。超时未验证会被移出群。</p>
      </div>
      <% if GroupConfig.column_names.include?('language') %>
        <div>
          <%= form.label :language, t('.labels.language'), class: "mb-1.5 block text-sm font-semibold text-slate-700" %>
          <%= form.select :language,
              options_for_select([[t('.language_options.auto'), ""]] + I18n.available_locales.map { |l| [t('.language_options.' + l.to_s, default: l.to_s.upcase), l.to_s] }, group_config.language),
              { include_blank: true }, class: "w-full px-3 py-2" %>
          <p class="mt-1 text-xs text-slate-500">选择后群内 bot 消息会优先使用该语言。</p>
        </div>
      <% end %>
    </div>
  </section>

  <section class="panel-card overflow-hidden">
    <div class="border-b border-slate-200/70 px-5 py-4 sm:px-6">
      <h2 class="text-lg font-black text-slate-950"><%= t('.welcome') %></h2>
      <p class="mt-1 text-sm text-slate-500">欢迎语支持 <code class="rounded bg-slate-100 px-1.5 py-0.5">{name}</code> 和 <code class="rounded bg-slate-100 px-1.5 py-0.5">{title}</code> 变量。</p>
    </div>
    <div class="space-y-5 p-5 sm:p-6">
      <div>
        <%= form.label :welcome_text, t('.welcome_text'), class: "mb-1.5 block text-sm font-semibold text-slate-700" %>
        <%= form.text_area :welcome_text, rows: 8, class: "w-full px-3 py-2 font-mono text-sm" %>
      </div>
      <div class="grid grid-cols-1 gap-5 md:grid-cols-2">
        <div>
          <%= form.label :welcome_photo_id, t('.welcome_photo'), class: "mb-1.5 block text-sm font-semibold text-slate-700" %>
          <%= form.text_field :welcome_photo_id, class: "w-full px-3 py-2" %>
        </div>
        <div>
          <%= form.label :welcome_video_id, t('.welcome_video'), class: "mb-1.5 block text-sm font-semibold text-slate-700" %>
          <%= form.text_field :welcome_video_id, class: "w-full px-3 py-2" %>
        </div>
      </div>
      <div>
        <%= form.label :welcome_buttons_json, t('.welcome_buttons'), class: "mb-1.5 block text-sm font-semibold text-slate-700" %>
        <%= form.text_area :welcome_buttons_json, rows: 6, class: "w-full px-3 py-2 font-mono text-sm",
            value: group_config.welcome_buttons_json.presence || '[{"text":"Example","url":"https://t.me"}]' %>
        <p class="mt-1 text-xs text-slate-500">JSON 格式，适合放安装链接、官网或文档按钮。</p>
      </div>
    </div>
  </section>

  <section class="panel-card overflow-hidden">
    <div class="border-b border-slate-200/70 px-5 py-4 sm:px-6">
      <h2 class="text-lg font-black text-slate-950"><%= t('.cleanup') %></h2>
      <p class="mt-1 text-sm text-slate-500">单位是分钟；0 表示不删除。广告原文识别后会直接删除，不受这里影响。</p>
    </div>
    <% cleanup_delay_fields = [
      [:alert_delete_delay, t('.labels.alert_delete_delay')],
      [:keyword_delete_delay, t('.labels.keyword_delete_delay')]
    ] %>
    <% cleanup_delay_fields << [:forward_delete_delay, t('.labels.forward_delete_delay')] if GroupConfig.column_names.include?('forward_delete_delay') %>
    <% cleanup_delay_fields << [:welcome_delete_delay, t('.labels.welcome_delete_delay')] if GroupConfig.column_names.include?('welcome_delete_delay') %>
    <div class="grid grid-cols-1 gap-5 p-5 sm:p-6 md:grid-cols-2">
      <% cleanup_delay_fields.each do |field, label| %>
        <div>
          <%= form.label field, label, class: "mb-1.5 block text-sm font-semibold text-slate-700" %>
          <%= form.number_field field, min: 0, class: "w-full px-3 py-2" %>
        </div>
      <% end %>
    </div>
  </section>

<% end %>
