<%= form_with(model: group_config, class: "contents") do |form| %>
  <% if group_config.errors.any? %>
    <div class="bg-red-50 text-red-500 px-4 py-3 rounded mb-5">
      <h2><%= t('.error_header') %></h2>
      <ul class="list-disc ml-4 mt-2">
        <% group_config.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="bg-white p-6 rounded-lg shadow-md border border-gray-200 space-y-6">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div>
        <%= form.label :group_id, class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= form.number_field :group_id, class: "w-full rounded-lg border-gray-300 shadow-sm py-2 px-3" %>
      </div>
      <div>
        <%= form.label :group_name, class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= form.text_field :group_name, class: "w-full rounded-lg border-gray-300 shadow-sm py-2 px-3" %>
      </div>
    </div>

    <hr class="border-gray-200">

    <h3 class="text-lg font-semibold"><%= t('.verification') %></h3>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div>
        <%= form.label :verification_mode, class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= form.select :verification_mode,
            options_for_select([[t('.verification_modes.none'), "none"], [t('.verification_modes.button'), "button"], [t('.verification_modes.math'), "math"]], group_config.verification_mode),
            {}, class: "w-full rounded-lg border-gray-300 shadow-sm py-2 px-3" %>
      </div>
      <div>
        <%= form.label :verification_timeout, t('.labels.verification_timeout'), class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= form.number_field :verification_timeout, class: "w-full rounded-lg border-gray-300 shadow-sm py-2 px-3" %>
      </div>
    </div>
    <% if GroupConfig.column_names.include?('language') %>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div>
        <%= form.label :language, t('.labels.language'), class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= form.select :language,
            options_for_select([[t('.language_options.auto'), ""]] + I18n.available_locales.map { |l| [t('.language_options.' + l.to_s, default: l.to_s.upcase), l.to_s] }, group_config.language),
            { include_blank: true }, class: "w-full rounded-lg border-gray-300 shadow-sm py-2 px-3" %>
      </div>
    </div>
    <% end %>

    <hr class="border-gray-200">

    <h3 class="text-lg font-semibold"><%= t('.welcome') %></h3>
    <div>
      <%= form.label :welcome_text, t('.welcome_text'), class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= form.text_area :welcome_text, rows: 4, class: "w-full rounded-lg border-gray-300 shadow-sm py-2 px-3" %>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div>
        <%= form.label :welcome_photo_id, t('.welcome_photo'), class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= form.text_field :welcome_photo_id, class: "w-full rounded-lg border-gray-300 shadow-sm py-2 px-3" %>
      </div>
      <div>
        <%= form.label :welcome_video_id, t('.welcome_video'), class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= form.text_field :welcome_video_id, class: "w-full rounded-lg border-gray-300 shadow-sm py-2 px-3" %>
      </div>
    </div>
    <div>
      <%= form.label :welcome_buttons_json, t('.welcome_buttons'), class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= form.text_area :welcome_buttons_json, rows: 3, class: "w-full rounded-lg border-gray-300 shadow-sm py-2 px-3 font-mono text-sm",
          value: group_config.welcome_buttons_json.presence || '[{"text":"Example","url":"https://t.me"}]' %>
    </div>

    <hr class="border-gray-200">

    <h3 class="text-lg font-semibold"><%= t('.cleanup') %></h3>
    <% cleanup_delay_fields = [
      [:alert_delete_delay, t('.labels.alert_delete_delay')],
      [:keyword_delete_delay, t('.labels.keyword_delete_delay')]
    ] %>
    <% cleanup_delay_fields << [:forward_delete_delay, t('.labels.forward_delete_delay')] if GroupConfig.column_names.include?('forward_delete_delay') %>
    <% cleanup_delay_fields << [:welcome_delete_delay, t('.labels.welcome_delete_delay')] if GroupConfig.column_names.include?('welcome_delete_delay') %>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <% cleanup_delay_fields.each do |field, label| %>
        <div>
          <%= form.label field, label, class: "block text-sm font-medium text-gray-700 mb-1" %>
          <%= form.number_field field, min: 0, class: "w-full rounded-lg border-gray-300 shadow-sm py-2 px-3" %>
        </div>
      <% end %>
    </div>

    <div class="flex items-center space-x-3 pt-4">
      <%= form.submit class: "rounded-lg px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white font-medium cursor-pointer" %>
    </div>
  </div>
<% end %>
