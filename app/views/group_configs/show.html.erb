<% content_for :title, t('.title', group: @group_config.group_name || @group_config.group_id) %>

<div class="w-full max-w-5xl mx-auto space-y-6">
  <div>
    <p class="text-sm font-semibold uppercase tracking-[0.18em] text-blue-600"><%= t('layout.group_configs') %></p>
    <h1 class="page-title mt-2"><%= @group_config.group_name || @group_config.group_id %></h1>
    <p class="page-subtitle">ID <%= @group_config.group_id %> · <%= t('.title', group: @group_config.group_name || @group_config.group_id) %></p>
  </div>

  <section class="grid grid-cols-1 gap-4 md:grid-cols-3">
    <div class="panel-card p-5">
      <p class="text-sm font-semibold text-slate-500"><%= t('.mode') %></p>
      <p class="mt-2 text-2xl font-black text-slate-950"><%= @group_config.verification_mode.humanize %></p>
      <p class="mt-1 text-sm text-slate-500"><%= t('.verification') %></p>
    </div>
    <div class="panel-card p-5">
      <p class="text-sm font-semibold text-slate-500"><%= t('.timeout') %></p>
      <p class="mt-2 text-2xl font-black text-slate-950"><%= @group_config.verification_timeout %><span class="ml-1 text-base font-semibold text-slate-500"><%= t('.seconds') %></span></p>
      <p class="mt-1 text-sm text-slate-500"><%= t('.verification') %></p>
    </div>
    <div class="panel-card p-5">
      <p class="text-sm font-semibold text-slate-500"><%= t('.language') %></p>
      <p class="mt-2 text-2xl font-black text-slate-950">
        <% if GroupConfig.column_names.include?('language') %>
          <%= @group_config.language.present? ? @group_config.language.upcase : t('.language_auto') %>
        <% else %>
          <%= t('.language_auto') %>
        <% end %>
      </p>
      <p class="mt-1 text-sm text-slate-500">Bot locale</p>
    </div>
  </section>

  <section class="panel-card overflow-hidden">
    <div class="border-b border-slate-200/70 px-5 py-4 sm:px-6">
      <h2 class="text-lg font-black text-slate-950"><%= t('.welcome_message') %></h2>
      <p class="mt-1 text-sm text-slate-500">支持 Markdown、媒体和内联按钮。</p>
    </div>
    <div class="grid grid-cols-1 gap-5 p-5 sm:p-6 lg:grid-cols-3">
      <div class="lg:col-span-2">
        <p class="mb-2 text-sm font-semibold text-slate-600"><%= t('.text') %></p>
        <div class="max-h-72 overflow-auto rounded-2xl border border-slate-200 bg-slate-50/90 p-4 font-mono text-sm leading-7 text-slate-800 whitespace-pre-wrap"><%= @group_config.welcome_text.presence || "—" %></div>
      </div>
      <div class="space-y-4">
        <div class="rounded-2xl border border-slate-200 bg-white/70 p-4">
          <p class="text-sm font-semibold text-slate-600"><%= t('.photo') %></p>
          <p class="mt-2 break-all text-sm text-slate-800"><%= @group_config.welcome_photo_id.presence || "未设置" %></p>
        </div>
        <div class="rounded-2xl border border-slate-200 bg-white/70 p-4">
          <p class="text-sm font-semibold text-slate-600"><%= t('.video') %></p>
          <p class="mt-2 break-all text-sm text-slate-800"><%= @group_config.welcome_video_id.presence || "未设置" %></p>
        </div>
      </div>
    </div>
    <div class="border-t border-slate-200/70 p-5 sm:p-6">
      <p class="mb-2 text-sm font-semibold text-slate-600"><%= t('.buttons') %></p>
      <pre class="bg-slate-950 p-4 text-sm text-slate-100"><%= JSON.pretty_generate(@group_config.welcome_buttons) rescue @group_config.welcome_buttons_json %></pre>
    </div>
  </section>

  <section class="panel-card p-5 sm:p-6">
    <div class="mb-5 flex flex-col gap-1">
      <h2 class="text-lg font-black text-slate-950"><%= t('.cleanup_settings') %></h2>
      <p class="text-sm text-slate-500">这里控制提示、欢迎、关键词和转发消息的清理延迟；广告原文识别后直接删除。</p>
    </div>
    <% cleanup_delays = [
      [t('.alert_delete_delay'), @group_config.alert_delete_delay],
      [t('.keyword_delete_delay'), @group_config.keyword_delete_delay]
    ] %>
    <% cleanup_delays << [t('.forward_delete_delay'), @group_config.forward_delete_delay] if GroupConfig.column_names.include?('forward_delete_delay') %>
    <% cleanup_delays << [t('.welcome_delete_delay'), @group_config.welcome_delete_delay] if GroupConfig.column_names.include?('welcome_delete_delay') %>
    <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-4">
      <% cleanup_delays.each do |label, value| %>
        <div class="rounded-2xl border border-slate-200 bg-white/70 p-4">
          <p class="text-sm font-semibold text-slate-500"><%= label %></p>
          <p class="mt-2 text-xl font-black <%= value.to_i > 0 ? 'text-blue-700' : 'text-slate-500' %>">
            <%= value.to_i > 0 ? "#{value} 分钟" : "不删除" %>
          </p>
        </div>
      <% end %>
    </div>
  </section>

  <div class="flex flex-col justify-end gap-2 sm:flex-row sm:gap-3">
    <%= link_to t('.edit_link'), edit_group_config_path(@group_config), class: "w-full sm:w-auto text-center rounded-xl bg-blue-600 px-4 py-2.5 font-semibold text-white shadow-lg shadow-blue-500/20 hover:bg-blue-700" %>
    <%= link_to t('.back_link'), group_configs_path(index_params), class: "w-full sm:w-auto text-center rounded-xl border border-slate-200 bg-white px-4 py-2.5 font-semibold text-slate-700 hover:bg-slate-50" %>
  </div>
</div>
