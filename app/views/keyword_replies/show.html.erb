<% content_for :title, t('.title') %>

<div class="md:w-2/3 w-full">
  <h1 class="font-bold text-4xl"><%= t('.title') %></h1>

  <div class="my-5 space-y-4">
    <div class="bg-white p-6 rounded-lg shadow-md border border-gray-200">
      <div class="grid grid-cols-2 gap-4 mb-4">
        <div><strong><%= t('.group_id') %>:</strong> <%= @keyword_reply.group_id %></div>
        <div><strong><%= t('.keyword') %>:</strong> <code class="bg-gray-100 px-2 py-1 rounded"><%= @keyword_reply.keyword %></code></div>
        <div><strong><%= t('.match_mode') %>:</strong>
          <% if @keyword_reply.is_exact? %><%= t('.match_modes.exact') %><% elsif @keyword_reply.is_regex? %><%= t('.match_modes.regex') %><% else %><%= t('.match_modes.include') %><% end %>
        </div>
        <div><strong><%= t('.reply_type') %>:</strong> <%= @keyword_reply.reply_type.humanize %></div>
      </div>

      <div>
        <strong class="block font-medium mb-1"><%= t('.reply_content') %>:</strong>
        <div class="bg-gray-50 p-3 rounded whitespace-pre-wrap"><%= @keyword_reply.reply_content %></div>
        <% if @keyword_reply.reply_text.present? %>
          <div class="mt-2">
            <strong class="block font-medium mb-1"><%= t('.with_caption') %>:</strong>
            <div class="bg-gray-50 p-3 rounded"><%= @keyword_reply.reply_text %></div>
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <div class="flex flex-col sm:flex-row gap-2 sm:gap-3">
    <%= link_to t('.edit_link'), edit_keyword_reply_path(@keyword_reply), class: "w-full sm:w-auto text-center rounded-lg px-4 py-2.5 bg-gray-100 hover:bg-gray-50 inline-block font-medium transition-colors duration-150" %>
    <%= link_to t('.back_link'), keyword_replies_path, class: "w-full sm:w-auto text-center rounded-lg px-4 py-2.5 bg-gray-100 hover:bg-gray-50 inline-block font-medium transition-colors duration-150" %>
    <%= button_to t('.delete_link'), @keyword_reply, method: :delete, form_class: "sm:inline-block",
        class: "w-full sm:w-auto rounded-lg px-4 py-2.5 bg-red-100 hover:bg-red-200 text-red-700 font-medium cursor-pointer transition-colors duration-150",
        data: { turbo_confirm: t('keyword_replies.index.confirm') } %>
  </div>
</div>
