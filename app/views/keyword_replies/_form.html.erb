<%= form_with(model: keyword_reply, class: "space-y-6", id: "keyword-reply-form") do |form| %>
  <% if keyword_reply.errors.any? %>
    <div class="rounded-2xl border border-red-200 bg-red-50 px-4 py-3 text-red-700">
      <h2 class="font-bold"><%= t('.error_header') %></h2>
      <ul class="mt-2 list-disc space-y-1 pl-5 text-sm">
        <% keyword_reply.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <section class="panel-card overflow-hidden">
    <div class="border-b border-slate-200/70 px-5 py-4 sm:px-6">
      <h2 class="text-lg font-black text-slate-950">触发条件</h2>
      <p class="mt-1 text-sm text-slate-500">选择群组并设置关键词匹配方式。</p>
    </div>
    <div class="grid grid-cols-1 gap-5 p-5 sm:p-6 md:grid-cols-2">
      <div>
        <%= form.label :group_id, class: "mb-1.5 block text-sm font-semibold text-slate-700" %>
        <%= form.select :group_id,
            options_from_collection_for_select(@group_configs, :group_id, ->(g) { "#{g.group_name || '未知'} (#{g.group_id})" }, keyword_reply.group_id),
            { include_blank: "请选择群组" },
            class: "w-full px-3 py-2" %>
      </div>
      <div>
        <%= form.label :keyword, class: "mb-1.5 block text-sm font-semibold text-slate-700" %>
        <%= form.text_field :keyword, class: "w-full px-3 py-2" %>
      </div>
      <div>
        <%= form.label :reply_type, class: "mb-1.5 block text-sm font-semibold text-slate-700" %>
        <%= form.select :reply_type,
            options_for_select([[t('.reply_types.text'), "text"], [t('.reply_types.photo'), "photo"], [t('.reply_types.video'), "video"]], keyword_reply.reply_type),
            {}, class: "w-full px-3 py-2" %>
      </div>
      <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 sm:pt-7">
        <%= form.label :is_exact, class: "flex items-center gap-3 rounded-2xl border border-slate-200 bg-white/70 px-4 py-3 text-sm font-semibold text-slate-700" do %>
          <%= form.check_box :is_exact, class: "rounded border-slate-300 text-blue-600" %>
          <span><%= t('.labels.is_exact') %></span>
        <% end %>
        <%= form.label :is_regex, class: "flex items-center gap-3 rounded-2xl border border-slate-200 bg-white/70 px-4 py-3 text-sm font-semibold text-slate-700" do %>
          <%= form.check_box :is_regex, class: "rounded border-slate-300 text-blue-600" %>
          <span><%= t('.labels.is_regex') %></span>
        <% end %>
      </div>
    </div>
  </section>

  <section class="panel-card overflow-hidden">
    <div class="border-b border-slate-200/70 px-5 py-4 sm:px-6">
      <h2 class="text-lg font-black text-slate-950">回复内容</h2>
      <p class="mt-1 text-sm text-slate-500">文字模式填写回复文本；图片/视频模式填写 file_id，附带说明会作为 caption。</p>
    </div>
    <div class="space-y-5 p-5 sm:p-6">
      <div>
        <%= form.label :reply_content, t('.labels.reply_content'), class: "mb-1.5 block text-sm font-semibold text-slate-700" %>
        <%= form.text_area :reply_content, rows: 6, class: "w-full px-3 py-2" %>
      </div>
      <div>
        <%= form.label :reply_text, t('.labels.caption'), class: "mb-1.5 block text-sm font-semibold text-slate-700" %>
        <%= form.text_area :reply_text, rows: 4, class: "w-full px-3 py-2" %>
      </div>
    </div>
  </section>
<% end %>
