<% content_for :title, t('.title') %>

<div class="w-full">
  <% if notice.present? %>
    <p class="py-2 px-3 bg-green-50 mb-5 text-green-500 font-medium rounded-lg inline-block text-sm" id="notice"><%= notice %></p>
  <% end %>

  <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center mb-6 gap-3">
    <h1 class="font-bold text-2xl sm:text-3xl md:text-4xl"><%= t('.title') %></h1>
    <%= link_to t('.new_button'), new_keyword_reply_path, class: "w-full sm:w-auto text-center rounded-lg px-4 py-2.5 bg-blue-600 hover:bg-blue-700 text-white font-medium transition-colors duration-150" %>
  </div>

  <% if @group_names.any? %>
    <div class="mb-4 bg-white rounded-lg shadow-sm border border-gray-200 p-4">
      <%= form_with url: keyword_replies_path, method: :get, local: true, class: "flex flex-col sm:flex-row sm:items-center gap-3" do |form| %>
        <%= form.select :group_name,
            options_for_select([[t('.filter_group'), "all"]] + @group_names.map { |n| [n, n] }, params[:group_name]),
            {}, class: "w-full sm:w-auto rounded-lg border-gray-300 shadow-sm py-2 px-3" %>
        <%= form.submit t('.filter_button'), class: "w-full sm:w-auto px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-lg font-medium cursor-pointer transition-colors duration-150" %>
      <% end %>
    </div>
  <% end %>

  <div class="hidden sm:block bg-white rounded-lg shadow-sm border border-gray-200 overflow-hidden">
    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"><%= t('.columns.group') %></th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"><%= t('.columns.keyword') %></th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"><%= t('.columns.match') %></th>
            <th class="hidden md:table-cell px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider"><%= t('.columns.reply') %></th>
            <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase tracking-wider"><%= t('.columns.actions') %></th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-gray-200">
          <% @keyword_replies.each do |kr| %>
            <tr class="hover:bg-gray-50 transition-colors duration-150">
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900"><%= kr.group_id %></td>
              <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900"><%= kr.keyword %></td>
              <td class="px-6 py-4 whitespace-nowrap text-sm">
                <%= tag.span t('.match_modes.exact'), class: "px-1.5 py-0.5 rounded text-xs bg-yellow-100 text-yellow-700" if kr.is_exact? %>
                <%= tag.span t('.match_modes.regex'), class: "px-1.5 py-0.5 rounded text-xs bg-red-100 text-red-700" if kr.is_regex? %>
                <%= tag.span t('.match_modes.include'), class: "px-1.5 py-0.5 rounded text-xs bg-blue-100 text-blue-700" if !kr.is_exact? && !kr.is_regex? %>
              </td>
              <td class="hidden md:table-cell px-6 py-4 text-sm text-gray-500 max-w-xs truncate">
                <% if kr.text? %>
                  <%= truncate(kr.reply_content, length: 50) %>
                <% elsif kr.photo? %>
                  📷 <%= truncate(kr.reply_text, length: 30) %>
                <% elsif kr.video? %>
                  🎬 <%= truncate(kr.reply_text, length: 30) %>
                <% end %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                <div class="action-group">
                  <%= link_to t('.actions.view'), keyword_reply_path(kr), class: "action-pill action-pill-primary" %>
                  <%= link_to t('.actions.edit'), edit_keyword_reply_path(kr), class: "action-pill" %>
                  <%= link_to t('.actions.delete'), keyword_reply_path(kr), method: :delete,
                      class: "action-pill action-pill-danger",
                      data: { turbo_confirm: t('.confirm') } %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>

  <div class="grid gap-3 sm:hidden">
    <% @keyword_replies.each do |kr| %>
      <article class="mobile-card p-4">
        <div class="flex items-start justify-between gap-3">
          <div class="min-w-0">
            <h2 class="truncate text-base font-black text-slate-950"><%= kr.keyword %></h2>
            <p class="mt-1 text-xs text-slate-500"><%= kr.group_id %></p>
          </div>
          <% if kr.is_exact? %>
            <%= tag.span t('.match_modes.exact'), class: "badge-soft bg-yellow-100 text-yellow-700" %>
          <% elsif kr.is_regex? %>
            <%= tag.span t('.match_modes.regex'), class: "badge-soft bg-red-100 text-red-700" %>
          <% else %>
            <%= tag.span t('.match_modes.include'), class: "badge-soft bg-blue-100 text-blue-700" %>
          <% end %>
        </div>
        <p class="mt-3 line-clamp-3 text-sm text-slate-600">
          <% if kr.text? %>
            <%= kr.reply_content %>
          <% elsif kr.photo? %>
            📷 <%= kr.reply_text %>
          <% elsif kr.video? %>
            🎬 <%= kr.reply_text %>
          <% end %>
        </p>
        <div class="mt-4 flex justify-end border-t border-slate-100 pt-3">
          <div class="action-group">
          <%= link_to t('.actions.view'), keyword_reply_path(kr), class: "action-pill action-pill-primary" %>
          <%= link_to t('.actions.edit'), edit_keyword_reply_path(kr), class: "action-pill" %>
          <%= link_to t('.actions.delete'), keyword_reply_path(kr), method: :delete,
              class: "action-pill action-pill-danger",
              data: { turbo_confirm: t('.confirm') } %>
          </div>
        </div>
      </article>
    <% end %>
  </div>
</div>
