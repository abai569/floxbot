<div id="<%= dom_id banned_user %>" class="bg-white p-6 rounded-lg shadow-sm border border-gray-200 space-y-4">
  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
    <div>
      <strong class="block text-sm font-medium text-gray-700 mb-1"><%= t('.group_id') %>:</strong>
      <span class="text-sm"><%= banned_user.group_id %></span>
    </div>
    <div>
      <strong class="block text-sm font-medium text-gray-700 mb-1"><%= t('.group_name') %>:</strong>
      <span class="text-sm"><%= banned_user.group_name %></span>
    </div>
    <div>
      <strong class="block text-sm font-medium text-gray-700 mb-1"><%= t('.sender_chat') %>:</strong>
      <span class="text-sm"><%= banned_user.sender_chat_id %></span>
    </div>
    <div>
      <strong class="block text-sm font-medium text-gray-700 mb-1"><%= t('.sender_user_name') %>:</strong>
      <span class="text-sm"><%= banned_user.sender_user_name %></span>
    </div>
    <div>
      <strong class="block text-sm font-medium text-gray-700 mb-1"><%= t('.message_id') %>:</strong>
      <span class="text-sm"><%= banned_user.message_id %></span>
    </div>
    <div>
      <strong class="block text-sm font-medium text-gray-700 mb-1"><%= t('.created_at') %>:</strong>
      <span class="text-sm"><%= banned_user.created_at.strftime("%Y-%m-%d %H:%M") %></span>
    </div>
  </div>
  <div>
    <strong class="block text-sm font-medium text-gray-700 mb-1"><%= t('.spam_message') %>:</strong>
    <div class="bg-gray-50 p-3 rounded-lg text-sm break-all mt-1"><%= banned_user.spam_message %></div>
  </div>
</div>
