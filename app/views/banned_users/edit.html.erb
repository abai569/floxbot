<% content_for :title, t('.title') %>
 
<div class="w-full max-w-5xl mx-auto space-y-6">
  <div>
    <p class="text-sm font-semibold uppercase tracking-[0.18em] text-blue-600"><%= t('layout.banned_users') %></p>
    <h1 class="page-title mt-2"><%= t('.title') %></h1>
  </div>
 
  <%= render "form", banned_user: @banned_user %>
 
  <div class="flex flex-col justify-end gap-2 sm:flex-row sm:gap-3">
    <%= link_to t('.show_link'), @banned_user, class: "w-full sm:w-auto text-center rounded-xl border border-slate-200 bg-white px-4 py-2.5 font-semibold text-slate-700 hover:bg-slate-50" %>
    <%= link_to t('.back_link'), banned_users_path, class: "w-full sm:w-auto text-center rounded-xl border border-slate-200 bg-white px-4 py-2.5 font-semibold text-slate-700 hover:bg-slate-50" %>
  </div>
</div>
