<%= form_with(model: banned_user, class: "contents") do |form| %>
  <% if banned_user.errors.any? %>
    <div id="error_explanation" class="bg-red-50 text-red-500 px-3 py-2 font-medium rounded-md mt-3">
      <h2><%= pluralize(banned_user.errors.count, t('.error_label', default: 'error')) %> <%= t('.error_header') %></h2>

      <ul class="list-disc ml-6">
        <% banned_user.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="bg-white p-6 rounded-lg shadow-md border border-gray-200 space-y-5">
    <div>
      <%= form.label :group_id, t('.labels.group_id'), class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= form.number_field :group_id, class: ["w-full rounded-lg border px-3 py-2", {"border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500": banned_user.errors[:group_id].none?, "border-red-400 focus:outline-red-600": banned_user.errors[:group_id].any?}] %>
    </div>

    <div>
      <%= form.label :sender_chat_id, t('.labels.sender_chat_id'), class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= form.number_field :sender_chat_id, class: ["w-full rounded-lg border px-3 py-2", {"border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500": banned_user.errors[:sender_chat_id].none?, "border-red-400 focus:outline-red-600": banned_user.errors[:sender_chat_id].any?}] %>
    </div>

    <div>
      <%= form.label :sender_user_name, t('.labels.sender_user_name'), class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= form.text_field :sender_user_name, class: ["w-full rounded-lg border px-3 py-2", {"border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500": banned_user.errors[:sender_user_name].none?, "border-red-400 focus:outline-red-600": banned_user.errors[:sender_user_name].any?}] %>
    </div>

    <div>
      <%= form.label :spam_message, t('.labels.spam_message'), class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= form.textarea :spam_message, rows: 4, class: ["w-full rounded-lg border px-3 py-2", {"border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500": banned_user.errors[:spam_message].none?, "border-red-400 focus:outline-red-600": banned_user.errors[:spam_message].any?}] %>
    </div>

    <div class="pt-2">
      <%= form.submit class: "w-full sm:w-auto rounded-lg px-4 py-2.5 bg-blue-600 hover:bg-blue-700 text-white font-medium cursor-pointer transition-colors duration-150" %>
    </div>
  </div>
<% end %>
