<% content_for :title, t('.title') %>
 
<div class="md:w-2/3 w-full">
  <% if notice.present? %>
    <p class="py-2 px-3 bg-green-50 mb-5 text-green-500 font-medium rounded-md inline-block" id="notice"><%= notice %></p>
  <% end %>
 
  <h1 class="font-bold text-2xl sm:text-3xl md:text-4xl mb-6"><%= t('.title') %></h1>
  
  <%= render @banned_user %>
  
  <div class="flex flex-col sm:flex-row gap-2 sm:gap-3 mt-6">
    <%= link_to t('.edit_link'), edit_banned_user_path(@banned_user), class: "w-full sm:w-auto text-center rounded-lg px-4 py-2.5 bg-gray-100 hover:bg-gray-50 inline-block font-medium transition-colors duration-150" %>
    <%= link_to t('.back_link'), banned_users_path(index_params), class: "w-full sm:w-auto text-center rounded-lg px-4 py-2.5 bg-gray-100 hover:bg-gray-50 inline-block font-medium transition-colors duration-150" %>
    <%= button_to t('.delete_link'), @banned_user, method: :delete, form_class: "sm:inline-block", class: "w-full sm:w-auto rounded-lg px-4 py-2.5 text-white bg-red-600 hover:bg-red-500 font-medium cursor-pointer transition-colors duration-150", data: { turbo_confirm: t('.confirm') } %>
  </div>
</div>
