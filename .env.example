# Required: Telegram Bot Token from @BotFather
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Required: Admin panel credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_secure_password_here

# Optional: Rails secret key base (generate via `rails secret` or `openssl rand -hex 64`)
# If not set, Rails auto-generates one (sessions won't persist across restarts)
SECRET_KEY_BASE=

# Optional: Web management port (defaults to 8060)
PORT=8060

# Optional: Database URL (defaults to SQLite)
# DATABASE_URL=sqlite3:///rails/storage/production.sqlite3
