# Required: Telegram Bot Token from @BotFather
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Required: Admin panel credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_secure_password_here

# Required in production: Rails secret key base
# Generate via: openssl rand -hex 64
SECRET_KEY_BASE=your_secret_key_base_here

# Optional: Web management port (defaults to 8060)
PORT=8060

# Optional: Database URL (defaults to SQLite)
# DATABASE_URL=sqlite3:///rails/storage/production.sqlite3
